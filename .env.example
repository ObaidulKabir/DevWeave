# DevWeave local development environment.
# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# ---------- PostgreSQL (SRS sections 3.1, 12.1) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=devweave
POSTGRES_USER=devweave
POSTGRES_PASSWORD=change-me-locally

# Application-facing connection string (least-privilege role in compose).
ConnectionStrings__DevWeave=Host=localhost;Port=5433;Database=devweave;Username=devweave;Password=change-me-locally;Options=-c role=devweave_app
# Privileged connection used only for MigrateOnStartup.
ConnectionStrings__DevWeaveMigrate=Host=localhost;Port=5433;Database=devweave;Username=devweave;Password=change-me-locally

# ---------- Object storage for artifacts (SRS sections 3.1, 7.1) ----------
# S3-compatible provider abstraction; MinIO is the local stand-in.
OBJECT_STORAGE__ENDPOINT=http://localhost:9000
OBJECT_STORAGE__ACCESSKEY=devweave
OBJECT_STORAGE__SECRETKEY=change-me-locally
OBJECT_STORAGE__BUCKET=devweave-artifacts
# Official minio/minio is no longer anonymously pullable; Chainguard is the compose default.
OBJECT_STORAGE_IMAGE=cgr.dev/chainguard/minio:latest
# Host ports published by docker compose; change if they clash with other local services.
# If you change OBJECT_STORAGE_PORT, update OBJECT_STORAGE__ENDPOINT and appsettings to match.
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
API_PORT=5080
STUDIO_PORT=8081

# ---------- API host ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# ---------- Identity (OIDC-compatible; SRS section 3.1) ----------
# Leave blank locally until the identity provider decision (OD-01) is closed.
# Empty Authority in Development enables /auth/pilot/* human JWT mint.
# Production cutover: see docs/ops/production-oidc-cutover.md
# Compose maps these to Auth__Oidc__Authority / Audience on the API.
OIDC__AUTHORITY=
OIDC__AUDIENCE=devweave-api
# Auth__Oidc__RequireHttpsMetadata=true
# ASPNETCORE_ENVIRONMENT=Production  # disables pilot JWT; requires OIDC__AUTHORITY
Auth__SigningKey=devweave-local-dev-signing-key-change-in-production-0123456789
DATABASE_MIGRATE_ON_STARTUP=true

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:5080
