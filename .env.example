# DevWeave local development environment.
# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# ---------- PostgreSQL (SRS sections 3.1, 12.1) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=devweave
POSTGRES_USER=devweave
POSTGRES_PASSWORD=change-me-locally

# Application-facing connection string.
ConnectionStrings__DevWeave=Host=localhost;Port=5433;Database=devweave;Username=devweave;Password=change-me-locally

# ---------- Object storage for artifacts (SRS sections 3.1, 7.1) ----------
# S3-compatible provider abstraction; MinIO is the local stand-in.
OBJECT_STORAGE__ENDPOINT=http://localhost:9000
OBJECT_STORAGE__ACCESSKEY=devweave
OBJECT_STORAGE__SECRETKEY=change-me-locally
OBJECT_STORAGE__BUCKET=devweave-artifacts

# ---------- API host ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# ---------- Identity (OIDC-compatible; SRS section 3.1) ----------
# Leave blank locally until the identity provider decision (OD-01) is closed.
# Empty Authority in Development enables /auth/pilot/* human JWT mint.
OIDC__AUTHORITY=
OIDC__AUDIENCE=devweave-api
Auth__SigningKey=devweave-local-dev-signing-key-change-in-production-0123456789

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:5080
