# Studio environment. Copy to .env.local for local overrides.

# Empty by default: the Vite dev server proxies API routes to the control-plane.
# Set an absolute origin when the studio is deployed separately from the API.
VITE_API_BASE_URL=

# Optional local/dev fallback when no browser session is present.
# Prefer signing in at /login (POST /auth/pilot/token) — session token wins over these.
# VITE_API_TOKEN must be a human bearer token accepted by DevWeave.Api.
VITE_TENANT_ID=
VITE_API_TOKEN=
# Optional: prefer this project id or key on load (defaults to taskboard-lite when present).
# VITE_PROJECT_ID=
